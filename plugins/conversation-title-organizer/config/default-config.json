        {"type": "实践", "prefixes": ["安装", "配置", "创建", "搭建", "生成", "制作", "部署", "发布", "卸载"], "keywords": ["导入", "执行", "运行"]},
        {"type": "调研", "prefixes": ["调研", "研究", "查找", "搜索"], "keywords": ["选型", "竞品", "资料搜集", "成熟方案"]},
        {"type": "评估", "prefixes": ["评估", "判断", "比较"], "keywords": ["有没有必要", "影响", "风险", "可行性", "是否适合"]},
        {"type": "规划", "prefixes": ["规划", "计划", "设计方案"], "keywords": ["路线图", "下一步", "实施方案"]},
        {"type": "复盘", "prefixes": ["复盘", "回顾"], "keywords": ["收获", "表现分析", "效果分析", "经验教训"]},
        {"type": "治理", "prefixes": ["整理", "规范", "清理", "盘点", "迁移"], "keywords": ["隐私", "归属", "目录", "项目结构", "会话标题", "命名规范"]},
        {"type": "沉淀", "prefixes": ["沉淀", "记录", "编写文档", "更新文档"], "keywords": ["手册", "说明文档", "知识库", "长期保存"]},
        {"type": "概念", "prefixes": ["解释", "了解"], "keywords": ["是什么", "区别", "作用", "原理", "如何理解"]}
      ]
    }
  },
  "projects": []
