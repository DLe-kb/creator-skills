{
  "version": 1,
  "date_format": "%m%d",
  "max_theme_chars": 24,
  "default_profile": "general",
  "local_fast_path": {
    "enabled": true,
    "min_score": 4,
    "min_margin": 2,
    "max_request_chars": 240
  },
  "ai": {
    "enabled": true,
    "base_url": "https://api.openai.com/v1",
    "model": "gpt-5-mini",
    "max_input_chars": 240,
    "max_output_tokens": 120,
    "request_timeout_seconds": 30
  },
  "profiles": {
    "general": {
      "types": ["概念", "调研", "评估", "规划", "实践", "开发", "验证", "排障", "复盘", "治理", "沉淀"],
      "rules": [
        {"type": "排障", "prefixes": ["修复", "排查", "解决"], "keywords": ["故障", "报错", "错误", "异常", "失败", "无法", "不可用", "打不开", "没反应", "阻塞"]},
        {"type": "验证", "prefixes": ["验证", "检查", "核对", "测试", "验收"], "keywords": ["一致性", "可用性", "兼容性", "是否正常"]},
