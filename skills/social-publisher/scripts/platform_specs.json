{
  "bilibili": {
    "display_name": "Bilibili",
    "default_route": "external-biliup",
    "free": true,
    "login_url": "https://member.bilibili.com/",
    "publish_url": "https://member.bilibili.com/platform/upload/video/frame"
  },
  "douyin": {
    "display_name": "Douyin",
    "default_route": "browser-local-free",
    "free": true,
    "login_url": "https://creator.douyin.com/",
    "publish_url": "https://creator.douyin.com/creator-micro/content/upload",
    "required_fields": ["title"],
    "limits": {"title_max": 30, "description_max": 1000, "video_max_bytes": 4294967296},
    "selectors": {
      "title": ["input[placeholder*='作品标题']", "input[placeholder*='标题']"],
      "description": ["textarea[placeholder*='作品简介']", "div[contenteditable='true']"],
      "publish": ["button:has-text('发布')"],
      "publish_success": ["text=发布成功", "text=发布完成"],
      "publish_error": ["text=发布失败", "text=上传失败"],
      "upload_error": ["text=上传失败"]
    }
  },
  "xiaohongshu": {
    "display_name": "Xiaohongshu",
    "default_route": "browser-local-free",
    "free": true,
    "login_url": "https://creator.xiaohongshu.com/",
    "publish_url": "https://creator.xiaohongshu.com/publish/publish?from=homepage&target=video",
    "required_fields": ["title"],
    "limits": {"title_max": 20, "description_max": 1000},
    "selectors": {
      "title": ["input[placeholder*='标题']", "input[placeholder*='title']"],
      "description": ["div[contenteditable='true']", "textarea[placeholder*='正文']", "textarea[placeholder*='描述']"],
      "publish": ["button:has-text('发布')"],
      "publish_success": ["text=发布成功", "text=提交成功"],
      "publish_error": ["text=发布失败", "text=上传失败"],
      "upload_error": ["text=上传失败"]
    }
  },
  "wechat-channels": {
    "display_name": "WeChat Channels",
    "default_route": "browser-local-free",
    "free": true,
    "login_url": "https://channels.weixin.qq.com/",
    "publish_url": "https://channels.weixin.qq.com/platform/post/create",
    "required_fields": ["short_title"],
    "limits": {"short_title_min": 6, "short_title_max": 16, "video_max_bytes": 21474836480, "duration_max_seconds": 28800, "min_width": 720, "max_video_bitrate": 10000000},
    "selectors": {
      "short_title": ["input[placeholder*='短标题']", "input[type='text']"],
      "description": ["div.input-editor", "div[contenteditable='true']", "textarea[placeholder*='描述']"],
      "publish": ["button:has-text('发表')", "button:has-text('发布')"],
      "publish_success": ["text=发表成功", "text=发布成功"],
      "publish_error": ["text=发表失败", "text=发布失败", "text=上传失败"],
      "upload_error": ["text=上传失败"]
    }
  },
  "youtube": {
    "display_name": "YouTube",
    "default_route": "youtube-data-api-free-quota",
    "free": true,
    "login_url": "https://studio.youtube.com/",
    "publish_url": "https://studio.youtube.com/",
    "required_fields": ["title", "made_for_kids"],
    "limits": {"title_max": 100, "description_max": 5000, "tags_total_max": 500, "cover_min_width": 640, "cover_aspect_ratio": 1.7777777778},
    "selectors": {
      "title": ["#textbox[aria-label*='title' i]", "#textbox[aria-label*='标题']", "ytcp-social-suggestions-textbox#title-textarea #textbox"],
      "description": ["#textbox[aria-label*='description' i]", "#textbox[aria-label*='说明']", "ytcp-social-suggestions-textbox#description-textarea #textbox"],
      "tags": ["input[aria-label*='tag' i]", "input[aria-label*='标签']"],
      "publish": ["#done-button", "button:has-text('保存')", "button:has-text('发布')"]
    }
  },
  "x": {
    "display_name": "X",
    "default_route": "browser-local-free",
    "free": true,
    "login_url": "https://x.com/home",
    "publish_url": "https://x.com/compose/post",
    "required_fields": ["description"],
    "limits": {"description_max": 280},
    "selectors": {
      "description": ["div[data-testid='tweetTextarea_0']", "div[role='textbox'][contenteditable='true']"],
      "publish": ["button[data-testid='tweetButton']", "button[data-testid='tweetButtonInline']"],
      "publish_success": ["div[data-testid='toast']:has-text('Your post was sent')", "div[data-testid='toast']:has-text('你的帖子已发送')"],
      "publish_error": ["div[data-testid='toast']:has-text('Something went wrong')", "div[data-testid='toast']:has-text('出错了')"]
    }
  },
  "tiktok": {
    "display_name": "TikTok",
    "default_route": "browser-local-free",
    "free": true,
    "login_url": "https://www.tiktok.com/tiktokstudio/upload",
    "publish_url": "https://www.tiktok.com/tiktokstudio/upload",
    "required_fields": ["description"],
    "limits": {"description_max": 4000, "video_max_bytes": 32212254720, "duration_max_seconds": 3600, "min_width": 360, "max_width": 4096},
    "selectors": {
      "description": ["div[contenteditable='true']", "textarea[placeholder*='caption' i]", "textarea[placeholder*='描述']"],
      "publish": ["button:has-text('Post')", "button:has-text('发布')"],
      "publish_success": ["text=Your video has been uploaded", "text=Your video is being uploaded to TikTok", "text=发布成功", "text=上传成功"],
      "publish_error": ["text=Couldn't upload", "text=Upload failed", "text=上传失败"],
      "upload_error": ["text=Upload failed", "text=上传失败"]
    }
  }
}
